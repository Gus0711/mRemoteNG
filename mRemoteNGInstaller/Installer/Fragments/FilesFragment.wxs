<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <!--
        Everything the build produced is installed: the list is harvested at build time instead of being
        maintained by hand, so new assemblies, themes and runtime files (self-contained builds) are never missed.
        mRemoteNG.exe is installed by MainExeFragment.wxs (it carries the shortcuts' target and registry entries).
    -->
    <Fragment>
        <ComponentGroup Id="MandatoryComponents" Directory="INSTALLDIR">
            <Files Include="$(var.HarvestPath)\**">
                <Exclude Files="$(var.HarvestPath)\mRemoteNG.exe" />
                <Exclude Files="$(var.HarvestPath)\**\*.pdb" />
                <!-- user data a local (portable) run may have left in the build folder -->
                <Exclude Files="$(var.HarvestPath)\confCons.xml*" />
                <Exclude Files="$(var.HarvestPath)\pnlLayout.xml" />
                <Exclude Files="$(var.HarvestPath)\extApps.xml" />
                <Exclude Files="$(var.HarvestPath)\home.json" />
                <Exclude Files="$(var.HarvestPath)\*.log" />
            </Files>
        </ComponentGroup>
    </Fragment>
</Wix>
